rules_version = '2';
// userProgress/{uid}/records/{recordId}: private session/flag/highlight JSON fragments.
// kind/key/part immutable; parts 1..256, part 0..parts-1; revision UUID;
// value <=50k chars, deleted bool (tombstone), changedAt local ms, updatedAt server time.
// rooms/{code}: immutable owner/subject/questionIds/createdAt/expiresAt;
// state, round, memberIds, roundPlayers and answeredIds drive the game.
// players/{uid}: immutable name (1..24) and joinedAt.
// rounds/{round}/answers/{uid}: immutable uid, round, answer (1..80), submittedAt.
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){ return request.auth != null; }
  function fresh(r){ return r.expiresAt > request.time; }
  function owner(r){ return signed() && request.auth.uid == r.owner; }
  function member(r){ return signed() && request.auth.uid in r.memberIds; }
  function access(r){ return owner(r) || (member(r) && fresh(r)); }
  function room(code){ return get(/databases/$(database)/documents/rooms/$(code)).data; }
  function afterRoom(code){ return getAfter(/databases/$(database)/documents/rooms/$(code)).data; }
  function validRoom(r){
   return r.keys().hasAll(['owner','subject','questionIds','state','round','memberIds','roundPlayers','answeredIds','createdAt','expiresAt'])
    && r.keys().hasOnly(['owner','subject','questionIds','state','round','memberIds','roundPlayers','answeredIds','createdAt','expiresAt'])
    && r.owner is string && r.owner.size() > 0 && r.owner.size() <= 128
    && r.subject in ['Reading and Writing','Math']
    && r.questionIds is list && r.questionIds.size() >= 1 && r.questionIds.size() <= 20
    && r.questionIds.join(',').matches('^[a-f0-9]{8}(,[a-f0-9]{8})*$') && r.questionIds.join(',').size() <= 179
    && r.state in ['lobby','question','reveal','finished']
    && r.round is int && r.round >= 0 && r.round < r.questionIds.size()
    && r.memberIds is list && r.memberIds.size() <= 20 && r.memberIds.toSet().size() == r.memberIds.size()
    && r.roundPlayers is list && r.memberIds.hasAll(r.roundPlayers) && r.roundPlayers.toSet().size() == r.roundPlayers.size()
    && r.answeredIds is list && r.roundPlayers.hasAll(r.answeredIds) && r.answeredIds.toSet().size() == r.answeredIds.size()
    && r.createdAt is timestamp && r.expiresAt is timestamp && r.expiresAt > r.createdAt;
  }
  function validPlayer(p){ return p.keys().hasAll(['name','joinedAt']) && p.keys().hasOnly(['name','joinedAt']) && p.name is string && p.name.size() >= 1 && p.name.size() <= 24 && p.joinedAt is timestamp; }
  function validAnswer(a){
   return a.keys().hasAll(['uid','round','answer','submittedAt']) && a.keys().hasOnly(['uid','round','answer','submittedAt'])
    && a.uid is string && a.uid == request.auth.uid && a.round is int
    && a.answer is string && a.answer.size() >= 1 && a.answer.size() <= 80 && a.submittedAt is timestamp;
  }
  match /rooms/{code} {
   allow get: if signed() && (resource == null || owner(resource.data) || (fresh(resource.data) && (resource.data.state == 'lobby' || member(resource.data))));
   allow list: if false;
   allow create: if signed() && code.matches('^[A-HJ-NP-Z2-9]{6}$') && validRoom(request.resource.data)
    && request.resource.data.owner == request.auth.uid && request.resource.data.state == 'lobby'
    && request.resource.data.round == 0 && request.resource.data.roundPlayers.size() == 0 && request.resource.data.answeredIds.size() == 0
    && (request.resource.data.memberIds.size() == 0 || (request.resource.data.memberIds == [request.auth.uid] && existsAfter(/databases/$(database)/documents/rooms/$(code)/players/$(request.auth.uid))))
    && request.resource.data.createdAt == request.time && request.resource.data.expiresAt <= request.time + duration.value(24,'h');
   function joining(old,n){
    return old.state == 'lobby' && fresh(old) && n.diff(old).affectedKeys().hasOnly(['memberIds'])
     && !(request.auth.uid in old.memberIds) && request.auth.uid in n.memberIds
     && n.memberIds.hasAll(old.memberIds) && n.memberIds.size() == old.memberIds.size()+1
     && existsAfter(/databases/$(database)/documents/rooms/$(code)/players/$(request.auth.uid));
   }
   function leaving(old,n){
    return old.state == 'lobby' && n.diff(old).affectedKeys().hasOnly(['memberIds'])
     && request.auth.uid in old.memberIds && !(request.auth.uid in n.memberIds)
     && old.memberIds.hasAll(n.memberIds) && n.memberIds.size() == old.memberIds.size()-1
     && !existsAfter(/databases/$(database)/documents/rooms/$(code)/players/$(request.auth.uid));
   }
   function submitting(old,n){
    return old.state == 'question' && fresh(old) && request.auth.uid in old.roundPlayers
     && !(request.auth.uid in old.answeredIds) && n.diff(old).affectedKeys().hasOnly(['answeredIds'])
     && n.answeredIds.hasAll(old.answeredIds) && request.auth.uid in n.answeredIds && n.answeredIds.size() == old.answeredIds.size()+1
     && existsAfter(/databases/$(database)/documents/rooms/$(code)/rounds/$(string(old.round))/answers/$(request.auth.uid));
   }
   function revealing(old,n){
    return old.state == 'question' && n.state == 'reveal' && n.diff(old).affectedKeys().hasOnly(['state'])
     && (owner(old) || (member(old) && fresh(old) && old.roundPlayers.size() > 0 && old.answeredIds.hasAll(old.roundPlayers)));
   }
   function hosting(old,n){
    return owner(old) && (
     (n.state == 'finished' && n.diff(old).affectedKeys().hasOnly(['state']))
     || (fresh(old) && (
      (old.state == 'lobby' && n.state == 'lobby' && n.diff(old).affectedKeys().hasOnly(['memberIds']) && old.memberIds.hasAll(n.memberIds))
      || (old.state == 'lobby' && n.state == 'question' && n.round == 0 && n.memberIds.size() > 0 && n.roundPlayers == n.memberIds && n.answeredIds.size() == 0 && n.diff(old).affectedKeys().hasOnly(['state','roundPlayers','answeredIds']))
      || (old.state == 'reveal' && n.state == 'question' && n.round == old.round+1 && n.roundPlayers == n.memberIds && n.answeredIds.size() == 0 && n.diff(old).affectedKeys().hasOnly(['state','round','roundPlayers','answeredIds']))
     ))
    );
   }
   allow update: if signed() && validRoom(request.resource.data)
    && (joining(resource.data,request.resource.data) || leaving(resource.data,request.resource.data) || submitting(resource.data,request.resource.data) || revealing(resource.data,request.resource.data) || hosting(resource.data,request.resource.data));
   allow delete: if owner(resource.data) && resource.data.state == 'finished';
   match /players/{uid} {
    allow read: if signed() && access(room(code));
    allow create: if signed() && request.auth.uid == uid && validPlayer(request.resource.data)
     && request.resource.data.joinedAt == request.time && fresh(afterRoom(code)) && afterRoom(code).state == 'lobby' && uid in afterRoom(code).memberIds;
    allow update: if false;
    allow delete: if signed() && (request.auth.uid == uid || owner(room(code)))
     && ((room(code).state == 'lobby' && !(uid in afterRoom(code).memberIds)) || (owner(room(code)) && room(code).state == 'finished'));
   }
   match /rounds/{round}/answers/{uid} {
    allow read: if signed() && access(room(code)) && (request.auth.uid == uid || int(round) < room(code).round || (int(round) == room(code).round && room(code).state in ['reveal','finished']));
    allow create: if signed() && validAnswer(request.resource.data) && request.auth.uid == uid
     && room(code).state == 'question' && fresh(room(code)) && uid in room(code).roundPlayers
     && round == string(room(code).round) && request.resource.data.round == room(code).round
     && request.resource.data.submittedAt == request.time && !(uid in room(code).answeredIds) && uid in afterRoom(code).answeredIds;
    allow update: if false;
    allow delete: if signed() && owner(room(code)) && room(code).state == 'finished';
   }
  }
  // Community timings: account-free aggregate histograms; private markers have no time/outcome.
  function counterPath(){ return /databases/$(database)/documents/siteStats/answers; }
  function pointerPath(){ return /databases/$(database)/documents/contributors/$(request.auth.uid); }
  function eventPath(eventId){ return /databases/$(database)/documents/answerContributions/$(eventId); }
  function statPath(q,group,mode){
   let root = mode == 'live' ? 'liveQuestionStats' : 'questionStats';
   return /databases/$(database)/documents/$(root)/$(q)/groups/$(group);
  }
  function validContribution(d){
   return d.keys().hasAll(['uid','questionId','mode','eligible','createdAt'])
    && d.keys().hasOnly(['uid','questionId','mode','eligible','createdAt'])
    && d.uid == request.auth.uid && d.questionId is string && d.questionId.matches('^[a-f0-9]{8}$')
    && d.mode in ['solo','live'] && d.eligible is bool && d.createdAt == request.time;
  }
  function newEvent(){ return getAfter(eventPath(getAfter(pointerPath()).data.lastEvent)).data; }
  function hasNewEvent(){
   let pointer = getAfter(pointerPath()).data;
   return pointer.updatedAt == request.time && pointer.lastEvent is string
    && pointer.lastEvent.matches('^[a-f0-9]{64}$')
    && !exists(eventPath(pointer.lastEvent)) && validContribution(getAfter(eventPath(pointer.lastEvent)).data);
  }
  function emptyStats(){ return {'samples':0,'totalSeconds':0,'bins':{}}; }
  function oldStats(q,group,mode){ return exists(statPath(q,group,mode)) ? get(statPath(q,group,mode)).data : emptyStats(); }
  function afterStats(q,group,mode){ return existsAfter(statPath(q,group,mode)) ? getAfter(statPath(q,group,mode)).data : emptyStats(); }
  function validStats(d){
   return d.keys().hasAll(['samples','totalSeconds','bins','updatedAt']) && d.keys().hasOnly(['samples','totalSeconds','bins','updatedAt'])
    && d.samples is int && d.samples >= 1 && d.samples <= 1000000000
    && d.totalSeconds is int && d.totalSeconds >= d.samples && d.totalSeconds <= d.samples*7200
    && d.bins is map && d.bins.size() <= 7200 && d.updatedAt == request.time;
  }
  // Validate the histogram delta directly, without persisting an account's individual seconds.
  function validDelta(d,old){
   let seconds = d.totalSeconds-old.totalSeconds;
   let key = string(seconds);
   return validStats(d) && d.samples == old.samples+1 && seconds >= 1 && seconds <= 7200
    && d.bins.diff(old.bins).affectedKeys().hasOnly([key]) && d.bins.keys().hasAll(old.bins.keys())
    && d.bins[key] is int && d.bins[key] == old.bins.get(key,0)+1;
  }
  function outcomePair(q,mode,advanced,unchanged,seconds){
   let next = afterStats(q,advanced,mode);
   let old = oldStats(q,advanced,mode);
   return validDelta(next,old) && next.totalSeconds-old.totalSeconds == seconds
    && afterStats(q,unchanged,mode) == oldStats(q,unchanged,mode);
  }
  function timingPaired(d){
   let next = afterStats(d.questionId,'all',d.mode);
   let old = oldStats(d.questionId,'all',d.mode);
   let seconds = next.totalSeconds-old.totalSeconds;
   return validDelta(next,old)
    && (outcomePair(d.questionId,d.mode,'correct','incorrect',seconds) || outcomePair(d.questionId,d.mode,'incorrect','correct',seconds));
  }
  function validCounter(d){
   return d.keys().hasAll(['count','solo','live','startedAt','updatedAt']) && d.keys().hasOnly(['count','solo','live','startedAt','updatedAt'])
    && d.count is int && d.solo is int && d.live is int && d.count >= 0 && d.solo >= 0 && d.live >= 0
    && d.count == d.solo+d.live && d.startedAt is timestamp && d.updatedAt == request.time;
  }
  match /siteStats/answers {
   allow get: if signed();
   allow list: if false;
   allow create: if signed() && validCounter(request.resource.data) && request.resource.data.count == 0
    && request.resource.data.solo == 0 && request.resource.data.live == 0 && request.resource.data.startedAt == request.time;
   allow update: if signed() && validCounter(request.resource.data) && hasNewEvent()
    && request.resource.data.startedAt == resource.data.startedAt && request.resource.data.count == resource.data.count+1
    && request.resource.data.solo == resource.data.solo+(newEvent().mode == 'solo' ? 1 : 0)
    && request.resource.data.live == resource.data.live+(newEvent().mode == 'live' ? 1 : 0);
   allow delete: if false;
  }
  match /answerContributions/{eventId} {
   allow get: if signed() && (resource == null || resource.data.uid == request.auth.uid);
   allow list: if false;
   allow create: if signed() && eventId.matches('^[a-f0-9]{64}$') && validContribution(request.resource.data)
    && getAfter(pointerPath()).data.lastEvent == eventId
    && getAfter(counterPath()).data.count == get(counterPath()).data.count+1
    && (!request.resource.data.eligible || timingPaired(request.resource.data));
   allow update, delete: if false;
  }
  match /contributors/{uid} {
   function validPointer(d){ return d.keys().hasAll(['lastEvent','updatedAt']) && d.keys().hasOnly(['lastEvent','updatedAt'])
    && d.lastEvent is string && d.lastEvent.matches('^[a-f0-9]{64}$') && d.updatedAt == request.time; }
   allow get: if signed() && uid == request.auth.uid;
   allow list: if false;
   allow create, update: if signed() && uid == request.auth.uid && validPointer(request.resource.data) && hasNewEvent();
   allow delete: if false;
  }
  // Legacy first-seen markers remain private and read-only; repeat attempts are now included.
  match /timingParticipants/{uid}/questions/{questionId} {
   allow get: if signed() && uid == request.auth.uid;
   allow list, write: if false;
  }
  match /{statsRoot}/{questionId}/groups/{group} {
   function validIncrement(d){
    let event = newEvent();
    let old = oldStats(questionId,group,event.mode);
    let all = afterStats(questionId,'all',event.mode);
    let beforeAll = oldStats(questionId,'all',event.mode);
    return event.eligible && event.questionId == questionId && statsRoot == (event.mode == 'live' ? 'liveQuestionStats' : 'questionStats')
     && validDelta(d,old) && d.totalSeconds-old.totalSeconds == all.totalSeconds-beforeAll.totalSeconds;
   }
   allow get: if signed() && statsRoot in ['questionStats','liveQuestionStats'] && questionId.matches('^[a-f0-9]{8}$') && group in ['all','correct','incorrect'];
   allow list: if false;
   allow create, update: if signed() && statsRoot in ['questionStats','liveQuestionStats'] && group in ['all','correct','incorrect'] && hasNewEvent() && validIncrement(request.resource.data);
   allow delete: if false;
  }
  match /userProgress/{uid}/records/{recordId} {
   function progressOwner(){ return signed() && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
   function validProgress(d){
    return d.keys().hasAll(['kind','key','part','parts','revision','value','deleted','changedAt','updatedAt'])
     && d.keys().hasOnly(['kind','key','part','parts','revision','value','deleted','changedAt','updatedAt'])
     && recordId.matches('^(session|flag|highlight)_[a-f0-9]{64}_[0-9]{1,3}$')
     && d.kind in ['session','flag','highlight'] && d.key is string && d.key.size() > 0 && d.key.size() <= 180
     && d.part is int && d.parts is int && d.part >= 0 && d.parts >= 1 && d.parts <= 256 && d.part < d.parts
     && recordId.matches('^'+d.kind+'_[a-f0-9]{64}_'+string(d.part)+'$')
     && (d.kind == 'session' || d.key.matches('^[a-f0-9]{8}$'))
     && (d.kind != 'flag' || (d.parts == 1 && (d.deleted || d.value == 'true')))
     && d.revision is string && d.revision.matches('^[a-f0-9-]{36}$')
     && d.value is string && d.value.size() <= 50000 && d.deleted is bool
     && (!d.deleted || (d.value == '' && d.parts == 1 && d.part == 0))
     && d.changedAt is int && d.changedAt > 0 && d.changedAt <= request.time.toMillis()+300000
     && d.updatedAt == request.time;
   }
   allow read: if progressOwner();
   allow create: if progressOwner() && validProgress(request.resource.data);
   allow update: if progressOwner() && validProgress(request.resource.data)
    && request.resource.data.kind == resource.data.kind && request.resource.data.key == resource.data.key
    && request.resource.data.part == resource.data.part && request.resource.data.changedAt >= resource.data.changedAt;
   allow delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
